Screen {
    background: #0f0a06;
    color: #f5eee8;
}
#titlebar {
    height: 1;
    background: #2e1705;
    color: #ffeedd;
    padding: 0 1;
}
#lights { width: 8; }
#window-title { width: 1fr; text-align: center; }
#version { width: 12; text-align: right; color: #ffb066; }
#workspace { height: 1fr; padding: 1 1 0 1; }
#main-pane { width: 1fr; padding-right: 2; }
#conversation { height: 1fr; scrollbar-size: 1 1; scrollbar-color: #994d00; scrollbar-background: #1a0f05; }
#brand { height: auto; margin: 0 0 1 0; text-align: center; }
.panel {
    height: auto;
    border: round #ff7700;
    border-title-color: #ffaa33;
    border-title-style: bold;
    border-subtitle-color: #8bdfaa;
    padding: 0 1;
    margin-bottom: 1;
    background: #140c06;
}
#overview { margin: 0 1 1 1; }
#messages { height: auto; }
.turn { height: auto; margin: 0 1 1 1; }
.user-turn { background: #2b1605; }
.user-line { height: auto; padding: 0 1; color: #fff5eb; }
.reply-body { height: auto; }
.reply-note { height: auto; padding-left: 2; color: #b39a88; }
.creator-card { margin: 0 2 1 3; }
#activity { height: 1; padding-left: 1; color: #b39a88; }
#prompt {
    height: 3;
    border: none;
    border-top: solid #5c2d06;
    padding: 0 1;
    background: #180e07;
}
#prompt:focus { border-top: solid #ff8800; }
#sidebar {
    width: 44;
    border-left: solid #381a04;
    padding-left: 1;
    scrollbar-size: 1 1;
    scrollbar-color: #994d00;
    scrollbar-background: #1a0f05;
}
#mahakal { height: 21; min-height: 21; align: center middle; }
#mahakal-image { width: auto; height: 18; }
.mahakal-art { text-align: center; content-align: center middle; }
.panel-heading { display: none; }
#quick-commands Button {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    border: none;
    background: transparent;
    color: #f0dbcb;
    text-align: left;
    content-align: left middle;
    padding: 0;
}
#quick-commands Button:hover, #quick-commands Button:focus { background: #3d1e05; color: #ffbb66; }
#quick-commands Button:disabled { color: #8c6850; }
Footer { background: #291304; color: #d4b296; }
FooterKey { background: #291304; }
FooterKey .footer-key--key { background: #4d2204; color: #ffd299; }
FooterKey .footer-key--description { background: #291304; color: #e0c2aa; }
.narrow #sidebar { width: 100%; border-left: none; padding-left: 0; }
.narrow #main-pane { padding-right: 0; }
.short #overview { display: none; }
.short #brand { height: 2; margin-bottom: 1; }
